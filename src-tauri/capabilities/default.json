{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for all app windows (main + torn-off tab windows + drag ghost)",
  "windows": ["main", "w*", "ghost"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "opener:default",
    "opener:allow-open-url",
    "dialog:default"
  ]
}
