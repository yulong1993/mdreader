{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for all app windows (main + torn-off tab windows)",
  "windows": ["main", "w*"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:webview:allow-create-webview-window",
    "opener:default",
    "opener:allow-open-url",
    "dialog:default"
  ]
}
